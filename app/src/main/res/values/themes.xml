<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NorthMusic" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 1. Default Blue Splash Theme -->
    <style name="Theme.NorthMusic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NorthMusic</item>
    </style>

